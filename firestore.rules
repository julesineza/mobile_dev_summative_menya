rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function mySchoolId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId;
    }

    function inMySchool(data) {
      return signedIn() && data.schoolId == mySchoolId();
    }

    // The register screen needs the school list before an account exists.
    match /schools/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Each teacher can only read and edit their own profile.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'schoolId']);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'schoolId']);
      allow delete: if false;
    }

    // Classes belong to the teacher in teacherId.
    match /classes/{id} {
      allow read, delete: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if signedIn() && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid;
    }

    // Everything below is shared inside one school (schoolId on every document).
    match /students/{id} {
      allow read, delete: if inMySchool(resource.data);
      allow create: if inMySchool(request.resource.data);
      allow update: if inMySchool(resource.data)
        && request.resource.data.schoolId == resource.data.schoolId;
    }
    match /assessments/{id} {
      allow read, delete: if inMySchool(resource.data);
      allow create: if inMySchool(request.resource.data);
      allow update: if inMySchool(resource.data)
        && request.resource.data.schoolId == resource.data.schoolId;
    }
    match /assessmentResults/{id} {
      allow read, delete: if inMySchool(resource.data);
      allow create: if inMySchool(request.resource.data);
      allow update: if inMySchool(resource.data)
        && request.resource.data.schoolId == resource.data.schoolId;
    }
    match /tests/{id} {
      allow read, delete: if inMySchool(resource.data);
      allow create: if inMySchool(request.resource.data);
      allow update: if inMySchool(resource.data)
        && request.resource.data.schoolId == resource.data.schoolId;
    }
    match /supportPlans/{id} {
      allow read, delete: if inMySchool(resource.data);
      allow create: if inMySchool(request.resource.data);
      allow update: if inMySchool(resource.data)
        && request.resource.data.schoolId == resource.data.schoolId;
    }
    match /remedialClubs/{id} {
      allow read, delete: if inMySchool(resource.data);
      allow create: if inMySchool(request.resource.data);
      allow update: if inMySchool(resource.data)
        && request.resource.data.schoolId == resource.data.schoolId;
    }
    match /clubEnrollments/{id} {
      allow read, delete: if inMySchool(resource.data);
      allow create: if inMySchool(request.resource.data);
      allow update: if inMySchool(resource.data)
        && request.resource.data.schoolId == resource.data.schoolId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
